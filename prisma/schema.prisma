generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS MÉTIER
// ==========================================

enum RoleMission {
  Vendeur
  Finisseur
}

enum ModePaiement {
  COMPTANT
  CREDIT
  CB
  CHEQUE
  VIREMENT
}

enum StatutCredit {
  Oui
  Non
  En_cours @map("En cours")
}

enum UserRole {
  ADMIN
  OPERATION
}

// ==========================================
// AUTHENTIFICATION & SÉCURITÉ (FINGERPRINT)
// ==========================================

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String?
  telephone	   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SessionFingerprint {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  fingerprintHash String
  role            UserRole
  adminId         String?
  operationSlug   String?
  ipAddress       String?
  userAgent       String?
  lastActivityAt  DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

// ==========================================
// ANNUAIRE VENDEURS FJA (RH & CONTRATS)
// ==========================================

model Vendeur {
  id                 String   @id @default(cuid())
  prenom             String
  nom                String
  email              String?
  telephone          String?
  adresse            String?
  codePostal         String?
  ville              String?
  dateNaissance      String?
  lieuNaissance      String?
  nationalite        String?  @default("Française")
  nirEncrypted       String?  // N° Sécurité Sociale chiffré AES-256-GCM
  nirLast4           String?  // 4 derniers chiffres pour affichage masqué UI
  tauxCommissionBase Float    @default(5)
  fraisJournalierDef Float    @default(80)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  affectations       AffectationVendeur[]

  @@index([nom, prenom])
}

// ==========================================
// OPÉRATIONS COMMERCIALES & VENTES
// ==========================================

model Operation {
  id             String   @id @default(cuid())
  slug           String   @unique
  nomOperation   String
  magasin        String
  ville          String
  loginId        String   @unique
  loginPassword  String   // Hashé ou mot de passe dédié opération
  dateDebut      String   // Format YYYY-MM-DD (aligné avec le front)
  dateFin        String   // Format YYYY-MM-DD
  coefOperation  Float    @default(2.5)
  tva            Float    @default(1.2)
  vendeursEnPied String[] @default([]) // Tableau natif PostgreSQL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  affectations   AffectationVendeur[]
  ventes         Vente[]

  @@index([slug])
}

model AffectationVendeur {
  id              String      @id @default(cuid())
  operationId     String
  vendeurId       String
  role            RoleMission @default(Vendeur)
  dateDebut       String      // Format YYYY-MM-DD
  dateFin         String      // Format YYYY-MM-DD
  fraisJournalier Float       @default(80)
  commission      Float       @default(5)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  operation       Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  vendeur         Vendeur     @relation(fields: [vendeurId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([vendeurId])
}

model Vente {
  id            String        @id @default(cuid())
  operationId   String
  date          String        // Format YYYY-MM-DD
  numBL         String        @default("")
  client        String
  prixVenteTTC  Float         @default(0)
  acompte       Float         @default(0)
  prixAchatHT   Float         @default(0)
  modele        String        @default("")
  vendeurId     String        @default("") // Peut contenir un Vendeur.id OU "pied:Prénom"
  finisseurId   String        @default("") // Peut contenir un Vendeur.id OU "pied:Prénom"
  paiement      ModePaiement  @default(COMPTANT)
  livraisonTTC  Float         @default(0)
  creditAccepte StatutCredit? // Nullable (= "" côté front)
  observations  String        @default("Contremarque")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  operation     Operation     @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([date])
}
